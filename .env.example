# PAIOS Environment Configuration
# Copy to .env and fill in your values

# ========================================
# M0: PostgreSQL + n8n
# ========================================

# PostgreSQL
POSTGRES_USER=paios
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=paios

# n8n
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-to-a-secure-secret
N8N_ENCRYPTION_KEY=change-me-to-a-secure-key

# ========================================
# M1: Telegram
# ========================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-private-chat-id

# ========================================
# M2: Claude (add these in M2)
# ========================================
# CLAUDE_API_KEY=sk-...

# ========================================
# M3+: GitHub, Google Calendar, Reddit (add as needed)
# ========================================
# GITHUB_TOKEN=ghp_...
# GITHUB_OWNER=your-username
# GOOGLE_CALENDAR_ID=...
# GOOGLE_CREDENTIALS_JSON=...
# REDDIT_CLIENT_ID=...
# REDDIT_CLIENT_SECRET=...
# REDDIT_USER_AGENT=PAIOS/1.0
