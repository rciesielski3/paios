# PAIOS Environment Configuration
# Copy this file to .env and fill in your values

# PostgreSQL Database
POSTGRES_USER=paios
POSTGRES_PASSWORD=change_this_to_a_strong_password
POSTGRES_DB=paios
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# n8n
N8N_USER_MANAGEMENT_JWT_SECRET=change_this_to_random_jwt_secret
N8N_ENCRYPTION_KEY=change_this_to_random_encryption_key
N8N_HOST=localhost
N8N_PORT=3333
N8N_PROTOCOL=http

# Vault (git-backed configuration)
# Point to your private paios-vault repository
VAULT_PATH=../paios-vault

# Telegram Bot (M1 - Notifications)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Claude AI (M2+ - Synthesis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GitHub (M3 - Releases & Activity)
GITHUB_TOKEN=your_github_token_here

# Optional: n8n File Access
# Restrict file access to specific directories
# NOTE: this is currently hardcoded in docker-compose.yml (not templated from .env);
# kept here for documentation. /data/dedup.json is bind-mounted from ./data/dedup.json
# for the merge/dedup step in wf-daily-brief (see M3a task A3).
N8N_RESTRICT_FILE_ACCESS_TO=/vault;/data;/home/node/.n8n-files
