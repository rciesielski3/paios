    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/vault/system/config/watched-repositories.yaml",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        192,
        400
      ],
      "id": "load-watched-repos-yaml-001",
      "name": "Load Watched Repos YAML"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.all()[0].json.content || '';\n\ntry {\n  // Simple YAML parser for our use case\n  const lines = content.split('\\n');\n  const repos = [];\n  let inPriority1 = false;\n  \n  for (const line of lines) {\n    const trimmed = line.trim();\n    \n    // Check if we're entering the priority_1 section\n    if (trimmed === 'priority_1:') {\n      inPriority1 = true;\n      continue;\n    }\n    \n    // Check if we're entering a new top-level key\n    if (inPriority1 && trimmed && !trimmed.startsWith('-') && trimmed.includes(':')) {\n      inPriority1 = false;\n    }\n    \n    // Extract repos from priority_1 section\n    if (inPriority1 && trimmed.startsWith('- ')) {\n      const repo = trimmed.substring(2).trim();\n      if (repo) {\n        repos.push(repo);\n      }\n    }\n  }\n  \n  // Return each repo as a separate item for the loop\n  return repos.map((repo) => {\n    const [owner, name] = repo.split('/');\n    return {\n      json: {\n        owner,\n        repo: name,\n        full_repo: repo\n      }\n    };\n  });\n} catch (error) {\n  return [{\n    json: {\n      error: 'Failed to parse YAML: ' + error.message\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        400
      ],
      "id": "parse-watched-repos-001",
      "name": "Parse Watched Repos"
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.owner }}/{{ $json.repo }}/releases/latest",
        "method": "GET",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        600,
        400
      ],
      "id": "fetch-github-releases-001",
      "name": "Fetch Latest Releases",
      "credentials": {
        "githubApi": {
          "id": "JcrlJS02mAQjQ6QD",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const release = item.json;\n  return {\n    json: {\n      source: \"github_releases\",\n      source_id: `github_release_${release.name}_${release.tag_name}`,\n      title: `${release.name} released`,\n      url: release.html_url,\n      content: release.body ? release.body.substring(0, 500) : \"No release notes\",\n      priority: \"high\",\n      tags: [\"release\", release.name.toLowerCase()]\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        400
      ],
      "id": "normalize-github-releases-001",
      "name": "Normalize GitHub Releases"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/vault/system/config/hacker-news-filter.yaml",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        192,
        550
      ],
      "id": "load-hn-filter-yaml-001",
      "name": "Load HN Filter YAML"
    },
    {
      "parameters": {
        "jsCode": "const content = $input.all()[0].json.content || '';\n\ntry {\n  const lines = content.split('\\n');\n  const keywords = [];\n  let inKeywords = false;\n  \n  for (const line of lines) {\n    const trimmed = line.trim();\n    \n    if (trimmed === 'keywords:') {\n      inKeywords = true;\n      continue;\n    }\n    \n    if (inKeywords && trimmed && !trimmed.startsWith('-') && trimmed.includes(':')) {\n      inKeywords = false;\n    }\n    \n    if (inKeywords && trimmed.startsWith('- ')) {\n      const keyword = trimmed.substring(2).trim();\n      if (keyword) {\n        keywords.push(keyword);\n      }\n    }\n  }\n  \n  return [{\n    json: {\n      keywords: keywords\n    }\n  }];\n} catch (error) {\n  return [{\n    json: {\n      error: 'Failed to parse YAML: ' + error.message,\n      keywords: []\n    }\n  }];\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        550
      ],
      "id": "parse-hn-keywords-001",
      "name": "Parse HN Keywords"
    },
    {
      "parameters": {
        "url": "https://hacker-news.firebaseio.com/v0/topstories.json?print=pretty",
        "method": "GET",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        550,
        550
      ],
      "id": "fetch-hn-top-stories-001",
      "name": "Fetch HN Top Stories"
    },
    {
      "parameters": {
        "jsCode": "// The HTTP Request node returns one item per array element when the response\n// body is a top-level JSON array, so collect all items back into a single array\n// of story IDs before slicing (rather than assuming $input.all()[0].json is the array).\nconst allItems = $input.all();\nconst storyIds = (allItems.length === 1 && Array.isArray(allItems[0].json))\n  ? allItems[0].json\n  : allItems.map(item => item.json);\n\nreturn storyIds.slice(0, 100).map((id, idx) => ({\n  json: {\n    id: id,\n    index: idx\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        550
      ],
      "id": "prepare-hn-story-ids-001",
      "name": "Prepare HN Story IDs"
    },
    {
      "parameters": {
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{ $json.id }}.json",
        "method": "GET",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        850,
        550
      ],
      "id": "fetch-hn-story-details-001",
      "name": "Fetch HN Story Details"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst keywordsNode = items.find(item => item.json.keywords);\nconst keywords = keywordsNode ? keywordsNode.json.keywords : [];\n\nreturn items.map(item => ({\n  ...item,\n  json: {\n    ...item.json,\n    keywords: keywords\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        500
      ],
      "id": "attach-hn-keywords-001",
      "name": "Attach HN Keywords to Stories"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst keywords = $json.keywords || [];\nconst keywordLower = keywords.map(k => k.toLowerCase());\n\nreturn items.filter(item => {\n  const story = item.json;\n  if (!story || story.type !== 'story') {\n    return false;\n  }\n  const text = ((story.title || '') + ' ' + (story.url || '')).toLowerCase();\n  return keywordLower.some(keyword => text.includes(keyword));\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        600
      ],
      "id": "filter-hn-by-keywords-001",
      "name": "Filter HN by Keywords"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item, idx) => {\n  const story = item.json;\n  return {\n    json: {\n      source: 'hacker_news',\n      source_id: `hacker_news_${story.id}`,\n      title: story.title,\n      url: story.url || `https://news.ycombinator.com/item?id=${story.id}`,\n      content: `Score: ${story.score}. ${story.title}`,\n      priority: 'medium',\n      tags: ['hacker_news', 'tech']\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        550
      ],
      "id": "normalize-hn-stories-001",
      "name": "Normalize HN Stories"
    },
    {
      "parameters": {
        "mode": "combine",
        "mergeByFields": [],
        "options": {},
        "combinationMode": "multiplex"
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        900,
        600
      ],
      "id": "merge-hn-keywords-stories-001",
      "name": "Merge HN Keywords with Stories"
    },
    {
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/dedup.json",
        "options": {}
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        192,
        750
      ],
      "id": "load-dedup-state-001",
      "name": "Load Dedup State",
      "continueOnFail": true
    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        1300,
        475
      ],
      "id": "merge-releases-hn-001",
      "name": "Merge Releases and HN"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst dedupState = (items[0] && items[0].json.dedup) || {};\nconst sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000).toISOString();\n\n// Remove entries older than 7 days\nObject.keys(dedupState).forEach(key => {\n  if (dedupState[key] < sevenDaysAgo) {\n    delete dedupState[key];\n  }\n});\n\n// Filter items not already seen in the last 7 days\nconst filtered = items.filter(item => {\n  return !(item.json.source_id in dedupState);\n});\n\n// Strip the internal dedup-state bookkeeping field before passing items on\nreturn filtered.map(item => {\n  const { dedup, ...rest } = item.json;\n  return { json: rest };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        475
      ],
      "id": "filter-duplicates-7day-001",
      "name": "Filter Duplicates (7-day dedup)"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "destinationKey": "content",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        300,
        400
      ],
      "id": "extract-watched-repos-text-001",
      "name": "Extract Watched Repos Text"
    },
    {
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "destinationKey": "content",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        300,
        550
      ],
      "id": "extract-hn-filter-text-001",
      "name": "Extract HN Filter Text"
    },
    {
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "data",
        "destinationKey": "dedup",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        400,
        750
      ],
      "id": "extract-dedup-json-001",
      "name": "Extract Dedup JSON"
    },
    {
      "parameters": {
        "jsCode": "const dedup = ($input.all()[0].json.dedup) || {};\n\n// Strip legacy documentation/metadata keys - these are not real source_id entries\ndelete dedup._comment;\ndelete dedup._format;\ndelete dedup._example;\n\nreturn [{ json: { dedup } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
