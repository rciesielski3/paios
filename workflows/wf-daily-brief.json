    {
      "parameters": {
        "jsCode": "const repos = $input\n  .all()\n  .sort((a, b) =>\n    new Date(b.json.pushed_at).getTime() -\n    new Date(a.json.pushed_at).getTime()\n  )\n  .slice(0, 5)\n  .map(repo => ({\n    name: repo.json.name,\n    description: repo.json.description ?? \"\",\n    url: repo.json.html_url,\n    pushed_at: repo.json.pushed_at,\n    language: repo.json.language\n  }));\n\nreturn [\n  {\n    json: {\n      repositories: repos\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
