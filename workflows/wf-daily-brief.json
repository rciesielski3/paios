{
  "name": "PAIOS Daily Brief",
  "nodes": [
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "claude-sonnet-5",
          "mode": "list",
          "cachedResultName": "claude-sonnet-5"
        },
        "messages": {
          "values": [
            {
              "content": "=You are my technical Chief of Staff.\n\nAnalyze the following normalized items together.\n\nReturn ONE markdown Daily Brief.\n\nFocus only on projects worth my attention.\n\nIgnore insignificant changes.\n\nFormat:\n\n# Daily Brief\n\n## Projects worth attention\n\n- ...\n\n## Recommendations\n\n- ...\n\nNormalized Items:\n\n{{ JSON.stringify($input.all(), null, 2) }}"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [
        624,
        0
      ],
      "id": "6c5a1fe5-5976-464c-9047-b23bc271217d",
      "name": "Generate Daily Brief (Claude)",
      "credentials": {
        "anthropicApi": {
          "id": "gzrR9lDtjE2kgU7o",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all()[0].json || [];\nconst workflowRunId = $execution.id;\n\nreturn items.map(item => ({\n  source: item.source,\n  source_id: item.source_id,\n  title: item.title,\n  url: item.url,\n  content: item.content,\n  priority: item.priority,\n  tags: JSON.stringify(item.tags),\n  workflow_run_id: workflowRunId\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        200
      ],
      "id": "persist-normalized-items-001",
      "name": "Persist Normalized Items"
    },
    {
      "parameters": {
        "mode": "each",
        "resource": "query",
        "operation": "execute",
        "query": "INSERT INTO normalized_items (source, source_id, title, url, content, priority, tags, workflow_run_id) VALUES ($1, $2, $3, $4, $5, $6, $7, $8) ON CONFLICT (source_id) DO NOTHING;",
        "queryParameters": {
          "parameters": [
            {
              "name": "$1",
              "value": "={{ $json.source }}"
            },
            {
              "name": "$2",
              "value": "={{ $json.source_id }}"
            },
            {
              "name": "$3",
              "value": "={{ $json.title }}"
            },
            {
              "name": "$4",
              "value": "={{ $json.url }}"
            },
            {
              "name": "$5",
              "value": "={{ $json.content }}"
            },
            {
              "name": "$6",
              "value": "={{ $json.priority }}"
            },
            {
              "name": "$7",
              "value": "={{ $json.tags }}"
            },
            {
              "name": "$8",
              "value": "={{ $json.workflow_run_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1000,
        200
      ],
      "id": "insert-normalized-items-001",
      "name": "Insert to normalized_items",
      "credentials": {
        "postgres": {
          "id": "HHToxlsndTvWHnD3",
          "name": "paios-postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const brief = $input.all()[0].json.brief || '';\nconst itemsCount = $input.all()[1].json ? $input.all()[1].json.length : 0;\nconst today = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    date: today,\n    markdown_content: brief,\n    source_items_count: itemsCount\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        350
      ],
      "id": "persist-synthesized-brief-001",
      "name": "Persist Synthesized Brief"
    },
    {
      "parameters": {
        "resource": "query",
        "operation": "execute",
        "query": "INSERT INTO synthesized_briefs (date, markdown_content, source_items_count) VALUES ($1, $2, $3) ON CONFLICT (date) DO UPDATE SET markdown_content = EXCLUDED.markdown_content, source_items_count = EXCLUDED.source_items_count, generated_at = CURRENT_TIMESTAMP;",
        "queryParameters": {
          "parameters": [
            {
              "name": "$1",
              "value": "={{ $json.date }}"
            },
            {
              "name": "$2",
              "value": "={{ $json.markdown_content }}"
            },
            {
              "name": "$3",
              "value": "={{ $json.source_items_count }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        1000,
        350
      ],
      "id": "insert-synthesized-briefs-001",
      "name": "Insert to synthesized_briefs",
      "credentials": {
        "postgres": {
          "id": "HHToxlsndTvWHnD3",
          "name": "paios-postgres"
        }
      }
    },
    {
      "parameters": {
        "chatId": "=8920148969",
        "text": "={{$json.text}}",
        "additionalFields": {}
      },
      "id": "b3041f5f-e63c-4338-8040-a993040e3138",
      "name": "Send Telegram Brief",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [
        1200,
        -112
      ],
      "webhookId": "0191d33d-4263-4e9f-9c25-60b7c74013bb",
      "credentials": {
        "telegramApi": {
          "id": "dBaSxOlVYwt1q6k8",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const brief = $json.content[1].text;\n\nreturn [{\n  json: {\n    markdown: `# ${new Date().toISOString().slice(0,10)}\n\n${brief}\n\n---\n\nGenerated automatically by PAIOS\n`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
