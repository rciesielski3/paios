    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst promptText = (items[0] && items[0].json.promptText) || '';\nconst today = new Date().toLocaleDateString('en-US', {\n  weekday: 'short',\n  month: 'numeric',\n  day: 'numeric'\n});\n\nconst itemsText = items\n  .map(item => `[${item.json.source}] ${item.json.title}\\nURL: ${item.json.url}\\n${item.json.content}`)\n  .join('\\n---\\n');\n\nconst fullPrompt = `${promptText}\\n\\n## Today's Items (${today})\\n\\n${itemsText}\\n\\n## Your Brief`;\n\nreturn [{\n  json: {\n    prompt: fullPrompt,\n    items: items.map(item => item.json),\n    itemCount: items.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -150
      ],
      "id": "prepare-claude-input-001",
      "name": "Prepare Claude Input"
    },
    {
      "parameters": {
        "jsCode": "const response = $json;\nconst textBlocks = (response.content || []).filter(block => block.type === 'text');\nconst brief = textBlocks.length > 0 ? textBlocks[textBlocks.length - 1].text : '';\nconst sourceCount = ($('Prepare Claude Input').first().json.itemCount) || 0;\n\nreturn [{\n  json: {\n    brief,\n    sourceCount\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
