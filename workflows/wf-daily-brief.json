      "id": "8f6e36d2-bee5-46e7-b450-c02576e05a27",
      "name": "Select Top 5 Repositories"
    },
    {
      "parameters": {
        "jsCode": "const repos = $input.all()[0].json.repositories || [];\n\nconst normalizedItems = repos.map(repo => ({\n  source: 'github',\n  source_id: repo.url,\n  title: repo.name,\n  url: repo.url,\n  content: repo.description || '',\n  priority: 'medium',\n  tags: repo.language ? [repo.language] : []\n}));\n\nreturn [{\n  json: normalizedItems\n}];"
