      "id": "3bb1fcb9-d95c-40ab-a0a6-c5e364a6b336",
      "name": "Get GitHub Repositories",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [
        192,
        0
      ],
      "webhookId": "bb41da72-5f35-498e-b506-e940528c1a02",
      "credentials": {
        "githubApi": {
          "id": "JcrlJS02mAQjQ6QD",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const repos = $input\n  .all()\n  .sort((a, b) =>\n    new Date(b.json.pushed_at).getTime() -\n    new Date(a.json.pushed_at).getTime()\n  )\n  .slice(0, 5)\n  .map(repo => ({\n    name: repo.json.name,\n    description: repo.json.description ?? \"\",\n    url: repo.json.html_url,\n    pushed_at: repo.json.pushed_at,\n    language: repo.json.language\n  }));\n\nreturn [\n  {\n    json: {\n      repositories: repos\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ],
      "id": "8f6e36d2-bee5-46e7-b450-c02576e05a27",
      "name": "Select Top 5 Repositories"
    },
    {
      "parameters": {
        "jsCode": "const repos = $input.all()[0].json.repositories || [];\n\nconst normalizedItems = repos.map(repo => ({\n  source: 'github',\n  source_id: repo.url,\n  title: repo.name,\n  url: repo.url,\n  content: repo.description || '',\n  priority: 'medium',\n  tags: repo.language ? [repo.language] : []\n}));\n\nreturn [{\n  json: normalizedItems\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "id": "dedup-001",
      "name": "Dedup"
    },
    {
      "parameters": {
        "jsCode": "return [{\n\n  json: {\n\n    text: $json.content[1].text\n\n      .replace(/\\*\\*/g, \"\")\n\n      .replace(/^#/gm, \"\")\n\n      .replace(/`/g, \"\")\n\n  }\n\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
